      "Bash(git -C ../* push *:release/* *)",
      "Bash(git push * master)",
      "Bash(git push * master *)",
      "Bash(git push *:master)",
      "Bash(git push *:master *)",
      "Bash(git push * develop)",
      "Bash(git push * develop *)",
      "Bash(git push *:develop)",
      "Bash(git push *:develop *)",
      "Bash(git push * dev)",
      "Bash(git push * dev *)",
      "Bash(git push *:dev)",
      "Bash(git push *:dev *)",
      "Bash(git push * stage)",
      "Bash(git push * stage *)",
      "Bash(git push *:stage)",
      "Bash(git push *:stage *)",
      "Bash(git push * beta)",
      "Bash(git push * beta *)",
