{
  "_comment": "meta-architecture: kernel locks (deny), outside-world actions (ask, Andres approves in the moment), side projects and datasets (deny). Edits to product repos are refused by the guard's EDIT_ROOTS rule, so no product repo is named here (public repo). Previous versions: archive/.claude/settings.json and git history.",
  "autoMemoryEnabled": false,
  "permissions": {
    "deny": [
      "Edit(charter.md)",
      "Edit(scoreboard/**)",
      "Edit(.claude/hooks/**)",
      "Edit(.claude/settings.json)",
      "Edit(.claude/settings.local.json)",
      "Edit(.claude/agents/change-reviewer.md)",
      "Edit(~/.claude/settings.json)",
      "Write(charter.md)",
      "Write(scoreboard/**)",
      "Write(.claude/hooks/**)",
      "Write(.claude/settings.json)",
      "Write(.claude/settings.local.json)",
      "Write(.claude/agents/change-reviewer.md)",
      "Write(~/.claude/settings.json)",
      "Bash(*scoreboard/apply*)",
      "Bash(*scoreboard/relock*)",
      "Bash(*./relock*)",
      "Edit(../personal-university/**)",
      "Edit(../brand-system/**)",
      "Edit(../media-log/**)",
      "Edit(../the-debrief/**)",
      "Edit(../resale-desk/**)",
      "Edit(../galind/**)",
      "Edit(../living-universe/**)",
      "Edit(../zestyio/zesty-webengine-team/**)"
    ],
    "ask": [
      "Bash(gh pr merge*)",
      "Bash(gh api *merge*)",
      "Bash(git push *--force*)",
      "Bash(git push * -f*)",
      "Bash(git push *--mirror*)",
      "Bash(git push *--all*)",
      "Bash(git push *--delete*)",
      "Bash(git push * -d *)",
      "Bash(git -C * push *--force*)",
      "Bash(git -C * push * -f*)",
      "Bash(git -C * push *--mirror*)",
      "Bash(git -C * push *--all*)",
      "Bash(git -C * push *--delete*)",
      "Bash(git -C * push * -d *)",
      "Bash(git -C ../* push * main)",
      "Bash(git -C ../* push * main *)",
      "Bash(git -C ../* push *:main)",
      "Bash(git -C ../* push *:main *)",
      "Bash(git -C ../* push * master)",
      "Bash(git -C ../* push * master *)",
      "Bash(git -C ../* push *:master)",
      "Bash(git -C ../* push *:master *)",
      "Bash(git -C ../* push * develop)",
      "Bash(git -C ../* push * develop *)",
      "Bash(git -C ../* push *:develop)",
      "Bash(git -C ../* push *:develop *)",
      "Bash(git -C ../* push * dev)",
      "Bash(git -C ../* push * dev *)",
      "Bash(git -C ../* push *:dev)",
      "Bash(git -C ../* push *:dev *)",
      "Bash(git -C ../* push * stage)",
      "Bash(git -C ../* push * stage *)",
      "Bash(git -C ../* push *:stage)",
      "Bash(git -C ../* push *:stage *)",
      "Bash(git -C ../* push * beta)",
      "Bash(git -C ../* push * beta *)",
      "Bash(git -C ../* push *:beta)",
      "Bash(git -C ../* push *:beta *)",
      "Bash(git -C ../* push * stable)",
      "Bash(git -C ../* push * stable *)",
      "Bash(git -C ../* push *:stable)",
      "Bash(git -C ../* push *:stable *)",
      "Bash(git -C ../* push * production)",
      "Bash(git -C ../* push * production *)",
      "Bash(git -C ../* push *:production)",
      "Bash(git -C ../* push *:production *)",
      "Bash(git -C ../* push * release/*)",
      "Bash(git -C ../* push * release/* *)",
